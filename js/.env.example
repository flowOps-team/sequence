# Sequence Ledger API Configuration
# Copy this file to .env and update values as needed

# Server Configuration
NODE_ENV=development
PORT=8910

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/sequence_ledger

# API Keys Configuration
# JSON array of key objects with: name, email, publicKey, secretKeyHash
# secretKeyHash is the SHA256 hash of the API key
# Example: SHA256("123") = a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3
KEYS='[{"name":"Development","email":"dev@example.com","publicKey":"dev","secretKeyHash":"a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3"}]'

# Analytics (optional)
ANALYTICS_ENABLED=false
SEGMENT_WRITE_KEY=
